{
  "version": "0.2.0",
  "configurations": [{
    "name": "Run Git Sniffer", "type": "extensionHost", "request": "launch",
    "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--enable-proposed-api=gitsniffer.git-sniffer"],
    "outFiles": ["${workspaceFolder}/dist/**/*.js"], "preLaunchTask": "npm: compile"
  }]
}
