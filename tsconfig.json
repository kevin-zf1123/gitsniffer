{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
